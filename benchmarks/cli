#!/bin/sh
set -eu
case "$1" in
  registry-64|registry-512) exec python3 "$(dirname "$0")/registry.py" "${LOCKSMITH_BIN:-locksmith}" "${1#registry-}" ;;
esac
cd "$LOCKSMITH_BENCH_DIR/worktree"
case "$1" in
  merge) set -- merge ../base.yaml ../ours.yaml ../theirs.yaml ;;
  merge-context) set -- merge ../base.yaml ../ours.yaml ../theirs.yaml --context ../context.json ;;
  validate-workspace) set -- validate --workspace ;;
  converge) set -- converge HEAD ;;
  repair) set -- repair missing-snapshot ;;
  inspect) set -- inspect --json ../inspect.yaml ;;
  inspect-external-1000|inspect-external-4000) set -- inspect --json "../external-${1##*-}.yaml" ;;
  *) exit 2 ;;
esac
exec "${LOCKSMITH_BIN:-locksmith}" "$@" > "${LOCKSMITH_OUTPUT:-/dev/null}"
